# Copy this file to ".env" and fill in your Supabase project values.
# Project Settings -> API in the Supabase dashboard.
# These are PUBLIC (safe to expose) ONLY because Row Level Security is enabled
# by the schema.sql in /supabase. Do NOT paste the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
